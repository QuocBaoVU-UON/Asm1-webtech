            A landmark jazz album known for its unusual rhythms,
            memorable melodies and distinctive quartet performances.
        </description>
        <searchTags>
            <tag>jazz</tag>
            <tag>piano</tag>
            <tag>instrumental</tag>
        </searchTags>
        <reviews>
        </reviews>
        <picture>
            <pictureurl>images/time-out.jpg</pictureurl>
        </picture>
        <relatedURLs>
            <url>https://en.wikipedia.org/wiki/Time_Out_(Dave_Brubeck_Quartet_album)</url>
        </relatedURLs>
    </album>

    <album>
        <title>Getz/Gilberto</title>
        <artist>Stan Getz and João Gilberto</artist>
        <price>31.95</price>
        <description>
            A relaxed combination of jazz and Brazilian bossa nova
            featuring saxophone, guitar and gentle vocals.
        </description>
        <searchTags>
            <tag>bossa nova</tag>
            <tag>saxophone</tag>
            <tag>relaxed</tag>
        </searchTags>
        <reviews>
            <review score="5">&reviewMessage;: Smooth and relaxing.</review>
        </reviews>
        <picture>
            <pictureurl>images/getz-gilberto.jpg</pictureurl>
        </picture>
        <relatedURLs>
            <url>https://en.wikipedia.org/wiki/Getz/Gilberto</url>
        </relatedURLs>
    </album>

</albums>