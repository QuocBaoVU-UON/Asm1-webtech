<!DOCTYPE albums [

    <!ELEMENT albums (genre, album+)>
    <!ELEMENT genre (#PCDATA)>

    <!ELEMENT album (title, artist, price, description, searchTags, reviews, picture, relatedURLs)>

    <!ELEMENT title (#PCDATA)>
    <!ELEMENT artist (#PCDATA)>
    <!ELEMENT price (#PCDATA)>
    <!ELEMENT description (#PCDATA)>

    <!ELEMENT searchTags (tag*)>
    <!ELEMENT tag (#PCDATA)>

    <!ELEMENT reviews (review*)>
    <!ELEMENT review (#PCDATA)>

    <!ELEMENT picture (pictureurl+)>
    <!ELEMENT pictureurl (#PCDATA)>

    <!ELEMENT relatedURLs (url)>
    <!ELEMENT url (#PCDATA)>

    <!ATTLIST review
        score (0 | 1 | 2 | 3 | 4 | 5) #REQUIRED
    >

    <!ENTITY storeName "My Music Store">
    <!ENTITY reviewMessage "Customer Review">

]>
<albums>
    <genre>Jazz</genre>
    <album>
        <title>Kind of Blue</title>
        <artist>Miles Davis</artist>
        <price>29.95</price>
        <description>
            &storeName; presents a classic jazz album featuring relaxed,
            sophisticated performances and influential improvisation.
        </description>
        <searchTags>
            <tag>jazz</tag>
            <tag>trumpet</tag>
            <tag>smooth</tag>
        </searchTags>
        <reviews>
            <review score="5">&reviewMessage;: A timeless jazz recording.</review>
            <review score="4">Beautiful performances and atmosphere.</review>
        </reviews>
        <picture>
            <pictureurl>images/kind-of-blue.jpg</pictureurl>
        </picture>
        <relatedURLs>
            <url>https://en.wikipedia.org/wiki/Kind_of_Blue</url>
        </relatedURLs>
    </album>

    <album>
        <title>Time Out</title>
        <artist>Dave Brubeck Quartet</artist>
        <price>27.95</price>
